{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntpe.ai/schemas/knowledge/scene_schema.json",
  "title": "Scene Knowledge Schema",
  "description": "Schema for scene knowledge entities extracted from source text",
  "version": "1.0",
  "type": "object",
  "properties": {
    "entity_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this entity"
    },
    "entity_type": {
      "type": "string",
      "const": "scene",
      "description": "Entity type discriminator"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version for migration tracking"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Scene identifier (e.g., SC-001)"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^SC-\\d+$",
          "description": "Structured scene ID"
        },
        "title": {
          "type": "string",
          "description": "Descriptive title for the scene"
        },
        "volume": {
          "type": "integer",
          "minimum": 1,
          "description": "Volume number"
        },
        "chapter_range": {
          "type": "string",
          "description": "Chapter range (e.g., '1-3' or '5')"
        },
        "location": {
          "type": "string",
          "description": "Primary location of the scene"
        },
        "time_of_day": {
          "type": "string",
          "enum": ["dawn", "morning", "noon", "afternoon", "evening", "night", "midnight", "unknown"],
          "description": "Time of day for the scene"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character_id": { "type": "string" },
              "status": { "type": "string", "enum": ["present", "mentioned", "absent", "exited"] },
              "role": { "type": "string" }
            },
            "required": ["character_id", "status"]
          },
          "description": "Characters present in this scene"
        },
        "plot_points": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Plot point IDs referenced in this scene"
        },
        "summary": {
          "type": "string",
          "description": "Brief summary of the scene"
        },
        "tone": {
          "type": "string",
          "enum": ["tense", "restrained", "heated", "atmospheric", "neutral", "melancholic", "joyful", "ominous", "other"],
          "description": "Emotional tone of the scene"
        },
        "unresolved_references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "surface_form": { "type": "string" },
              "reference_type": { "type": "string" },
              "candidate_targets": { "type": "array", "items": { "type": "string" } },
              "resolution_status": { "type": "string", "enum": ["unresolved", "resolved", "deferred"] }
            },
            "required": ["surface_form", "reference_type"]
          },
          "description": "Unresolved references needing resolution"
        },
        "boundary_type": {
          "type": "string",
          "enum": ["same_scene", "scene_transition", "chapter_transition", "volume_transition", "time_skip", "perspective_shift"],
          "description": "Type of scene boundary"
        }
      },
      "additionalProperties": true
    },
    "source_text": {
      "type": "string",
      "description": "Source text segment from which this scene was extracted"
    },
    "source_location": {
      "type": "string",
      "description": "Location reference (volume, chapter, position)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Extraction confidence score"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "extraction_method": { "type": "string" },
        "extraction_model": { "type": "string" },
        "extraction_timestamp": { "type": "string", "format": "date-time" },
        "validator_version": { "type": "string" },
        "review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "needs_review"]
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Entity creation timestamp (UTC)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (UTC)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Entity version for optimistic locking"
    },
    "references": {
      "type": "object",
      "description": "References to other entities (key=reference_type, value=array of entity_ids)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for categorization"
    }
  },
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "name",
    "confidence",
    "created_at",
    "updated_at",
    "version"
  ],
  "additionalProperties": false
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntpe.ai/schemas/knowledge/character_schema.json",
  "title": "Character Knowledge Schema",
  "description": "Schema for character knowledge entities extracted from source text",
  "version": "1.0",
  "type": "object",
  "properties": {
    "entity_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this entity"
    },
    "entity_type": {
      "type": "string",
      "const": "character",
      "description": "Entity type discriminator"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version for migration tracking"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Canonical character name"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "canonical_name": {
          "type": "string",
          "description": "Official/canonical name of the character"
        },
        "source_name": {
          "type": "string",
          "description": "Original name as it appears in source text"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Alternative names, nicknames, titles"
        },
        "role": {
          "type": "string",
          "enum": ["protagonist", "antagonist", "supporting", "minor", "narrator", "unknown"],
          "description": "Character's role in the narrative"
        },
        "traits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Personality traits, characteristics"
        },
        "relationships": {
          "type": "object",
          "description": "Relationships to other characters (key=character_id, value=relationship type)"
        },
        "cultivation_realm": {
          "type": "string",
          "description": "Cultivation realm/power level (for xianxia/xuanhuan genres)"
        },
        "first_appearance": {
          "type": "string",
          "description": "First chapter/volume where character appears"
        },
        "knowledge_tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domain-specific tags for categorization"
        },
        "arc_summary": {
          "type": "string",
          "description": "Summary of character arc/progression"
        }
      },
      "additionalProperties": true
    },
    "source_text": {
      "type": "string",
      "description": "Source text segment from which this entity was extracted"
    },
    "source_location": {
      "type": "string",
      "description": "Location reference (volume, chapter, position)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Extraction confidence score"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "extraction_method": { "type": "string" },
        "extraction_model": { "type": "string" },
        "extraction_timestamp": { "type": "string", "format": "date-time" },
        "validator_version": { "type": "string" },
        "review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "needs_review"]
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Entity creation timestamp (UTC)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (UTC)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Entity version for optimistic locking"
    },
    "references": {
      "type": "object",
      "description": "References to other entities (key=reference_type, value=array of entity_ids)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for categorization"
    }
  },
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "name",
    "confidence",
    "created_at",
    "updated_at",
    "version"
  ],
  "additionalProperties": false
}
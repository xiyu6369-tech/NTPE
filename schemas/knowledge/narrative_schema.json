{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntpe.ai/schemas/knowledge/narrative_schema.json",
  "title": "Narrative Knowledge Schema",
  "description": "Schema for narrative knowledge entities (plot points, timelines, world rules) extracted from source text",
  "version": "1.0",
  "type": "object",
  "properties": {
    "entity_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this entity"
    },
    "entity_type": {
      "type": "string",
      "const": "narrative",
      "description": "Entity type discriminator"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version for migration tracking"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Narrative element identifier (e.g., PP-001, TL-001, WR-001)"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "narrative_type": {
          "type": "string",
          "enum": ["plot_point", "timeline", "world_rule", "character_milestone"],
          "description": "Type of narrative element"
        },
        "plot_point": {
          "type": "object",
          "properties": {
            "plot_id": { "type": "string", "pattern": "^PP-\\d+$" },
            "title": { "type": "string" },
            "type": { "type": "string", "enum": ["inciting", "rising", "climax", "falling", "resolution", "revelation", "twist", "setup"] },
            "description": { "type": "string" },
            "affected_characters": { "type": "array", "items": { "type": "string" } },
            "prerequisite_plots": { "type": "array", "items": { "type": "string" } },
            "consequence_plots": { "type": "array", "items": { "type": "string" } },
            "timeline_position": { "type": "number" }
          }
        },
        "timeline": {
          "type": "object",
          "properties": {
            "timeline_id": { "type": "string", "pattern": "^TL-\\d+$" },
            "name": { "type": "string" },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": { "type": "number" },
                  "event_id": { "type": "string" },
                  "event_type": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["position", "event_id"]
              }
            }
          }
        },
        "world_rule": {
          "type": "object",
          "properties": {
            "rule_id": { "type": "string", "pattern": "^WR-\\d+$" },
            "category": { "type": "string", "enum": ["cultivation_system", "magic_system", "political_structure", "geography", "history", "technology", "social_custom"] },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "constraints": { "type": "array", "items": { "type": "string" } },
            "exceptions": { "type": "array", "items": { "type": "string" } },
            "source_volume": { "type": "integer" }
          }
        },
        "character_milestone": {
          "type": "object",
          "properties": {
            "character_id": { "type": "string" },
            "milestone_type": { "type": "string", "enum": ["breakthrough", "relationship", "revelation", "loss", "achievement", "transformation"] },
            "description": { "type": "string" },
            "chapter": { "type": "integer" },
            "impact_level": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        }
      },
      "additionalProperties": true
    },
    "source_text": {
      "type": "string",
      "description": "Source text segment from which this narrative element was extracted"
    },
    "source_location": {
      "type": "string",
      "description": "Location reference (volume, chapter, position)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Extraction confidence score"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "extraction_method": { "type": "string" },
        "extraction_model": { "type": "string" },
        "extraction_timestamp": { "type": "string", "format": "date-time" },
        "validator_version": { "type": "string" },
        "review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "needs_review"]
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Entity creation timestamp (UTC)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (UTC)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Entity version for optimistic locking"
    },
    "references": {
      "type": "object",
      "description": "References to other entities (key=reference_type, value=array of entity_ids)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for categorization"
    }
  },
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "name",
    "confidence",
    "created_at",
    "updated_at",
    "version"
  ],
  "additionalProperties": false
}